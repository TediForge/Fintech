{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@config/*": ["src/config/*"],
      "@hooks/*": ["src/hooks/*"],
      "@lib/*": ["src/lib/*"],
      "@providers/*": ["src/providers/*"],
      "@auth/*": ["src/auth/*"],
      "@dashboard/*": ["src/screens/dashboard/*"],
      "@screens/*": ["src/screens/*"]
    },
    "allowJs": true,
    "checkJs": false,
    "jsx": "react",
    "moduleResolution": "node",
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "ignoreDeprecations": "6.0"
  },
  "exclude": [
    "node_modules",
    "dist",
    "android",
    "ios",
    "build",
    "web-build",
    "*.config.js",
    "**/expo-modules-core/**",
    "**/expo/**"
  ]
}
