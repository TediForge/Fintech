# db-01 (fintech): use DATABASE_URL or the DATABASE_HOST/PORT/NAME/USER/PASSWORD set.
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# db-02 (TediVerify)
TEDIVERIFY_DATABASE_HOST=
TEDIVERIFY_DATABASE_PORT=5432
TEDIVERIFY_DATABASE_NAME=
TEDIVERIFY_DATABASE_USER=
TEDIVERIFY_DATABASE_PASSWORD=
TEDIVERIFY_DATABASE_SSL=false
TEDIVERIFY_DATABASE_POOL_SIZE=10

# JWT
JWT_SECRET=
JWT_ALGORITHM=HS256

# SMTP (D-009)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=
SMTP_TIMEOUT_SECONDS=30

# FCM (D-009); provide a service-account JSON file path or inline JSON.
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=

# Email-outbox worker (D-009)
EMAIL_OUTBOX_INTERVAL_SECONDS=5
EMAIL_OUTBOX_BATCH_SIZE=10
EMAIL_OUTBOX_MAX_ATTEMPTS=5
